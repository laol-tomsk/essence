<h2>Proposed Tasks</h2>

<div class="probabilities-form">
  <% i = 1%>
  <% @proposed_tasks.each do |task| %>
    <% puts task %>
    <div class="form-item" style="display: inline-flex; margin: 10px">
      <span class="label">Task <%= i %></span>
      <input type="<text>" value="<%= task %>" style="width: 400px" />
    </div>
    <% i = i + 1%>
  <% end %>
  <br>
  <button class="semat_button">+</button>
  <button class="semat_button" style="color:white; background: blue">Create Tasks</button>
</div>

<% content_for :header_tags do %>
  <%= stylesheet_link_tag 'semat-essence-plugin', :plugin => 'semat_essence' %>
<% end %>